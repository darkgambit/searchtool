Private Function ParseTerms(ByVal v As Variant) As String()
    Dim raw As String, parts() As String, out() As String
    Dim i As Long, n As Long, t As String

    If IsError(v) Then v = ""
    If IsEmpty(v) Then v = ""
    raw = Replace(Replace(Replace(CStr(v), vbCrLf, ","), vbLf, ","), ";", ",")
    parts = Split(raw, ",")

    ReDim out(LBound(parts) To UBound(parts))
    n = LBound(parts) - 1
    For i = LBound(parts) To UBound(parts)
        t = NormalizeKey(parts(i))
        If Len(t) > 0 Then
            n = n + 1
            out(n) = t
        End If
    Next i

    If n < 0 Then
        ParseTerms = Array()
        Exit Function
    End If

    ReDim Preserve out(LBound(parts) To n)
    ParseTerms = out
End Function



Private Function CanonicalHeader(ByVal norm As String) As String
    Select Case norm
        Case "SERIALNUMBER", "SERIALNO", "SERIAL", "SERIALNUMBERNO"
            CanonicalHeader = "@SERIAL"
        Case "ASSET", "ASSETNUMBER", "ASSETNO", "ASSETCODE", _
             "OLDBARCODEASSETNUMBERFROMGSG", "OLDBARCODE"
            CanonicalHeader = "@ASSET"
        Case "BARCODE", "BARCODENUMBER", "BARCODENO"
            CanonicalHeader = "@BARCODE"
        Case Else
            CanonicalHeader = norm
    End Select
End Function


Private Function NormalizeKey(ByVal v As Variant) As String
    Dim s As String

    If IsError(v) Then Exit Function
    If IsEmpty(v) Then Exit Function
    If IsNull(v) Then Exit Function

    Select Case VarType(v)
        Case vbInteger, vbLong, vbSingle, vbDouble, vbCurrency, vbDecimal
            If v = Int(v) Then
                s = Format$(v, "0")
            Else
                s = CStr(v)
            End If
        Case Else
            s = CStr(v)
    End Select

    s = Replace(s, " ", "")
    s = Replace(s, vbTab, "")
    s = UCase$(Trim$(s))
    If Left$(s, 1) = "'" Then s = Mid$(s, 2)
    NormalizeKey = s
End Function


Private Function NormalizeHeader(ByVal v As Variant) As String
    Dim s As String

    If IsError(v) Then Exit Function
    If IsEmpty(v) Then Exit Function
    If IsNull(v) Then Exit Function

    s = UCase$(Trim$(CStr(v)))
    s = Replace(s, " ", "")
    s = Replace(s, "_", "")
    s = Replace(s, ".", "")
    s = Replace(s, "-", "")
    s = Replace(s, "(", "")
    s = Replace(s, ")", "")
    s = Replace(s, "/", "")
    s = Replace(s, "#", "")
    s = Replace(s, vbLf, "")
    s = Replace(s, vbCr, "")
    s = Replace(s, vbTab, "")
    NormalizeHeader = s
End Function


Private Function SafeVal(ByVal v As Variant) As Variant
    If IsError(v) Then
        SafeVal = ""
    ElseIf IsNull(v) Then
        SafeVal = ""
    Else
        SafeVal = v
    End If
End Function


Private Function CellOf(ByRef colArr As Variant, ByVal r As Long) As Variant
    CellOf = colArr(r, 1)
End Function


Private Function FileNameOf(ByVal p As String) As String
    Dim i As Long
    i = InStrRev(p, "\")
    If i > 0 Then FileNameOf = Mid$(p, i + 1) Else FileNameOf = p
End Function


Private Function AddErr(ByVal current As String, ByVal name As String) As String
    If Len(current) >= 160 Then
        AddErr = current
    ElseIf Len(current) = 0 Then
        AddErr = name
    Else
        AddErr = current & ", " & name
    End If
End Function


Private Function SearchSheet() As Worksheet
    Dim ws As Worksheet

    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets("SEARCH")
    On Error GoTo 0
    If ws Is Nothing Then Set ws = ThisWorkbook.Worksheets(1)
    Set SearchSheet = ws
End Function


Private Sub SetStatus(ByVal msg As String)
    On Error Resume Next
    SearchSheet.Range(STATUS_CELL).Value = msg
End Sub


